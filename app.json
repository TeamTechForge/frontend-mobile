{
  "expo": {
    "name": "StrayCare",
    "slug": "stray-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/straycarelogoicon.png",
    "scheme": "straycare",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.techforge.straycare",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCv7X13DcKqsRx-LajzoyeWGOGVqBoOtuA"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/straycarelogoicon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/straycarelogoicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/straycarelogo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StrayCare to access your photos.",
          "cameraPermission": "Allow StrayCare to use your camera."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow StrayCare to use your camera for video calls.",
          "microphonePermission": "Allow StrayCare to use your microphone for voice calls."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "19b64256-0d23-4d0c-bfaf-e92dd61a77e5"
      }
    }
  }
}
