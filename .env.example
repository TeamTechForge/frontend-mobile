# Frontend Mobile Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────

# Backend API URL — set to your computer's LAN IP
# Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to find it.
# Both your phone and PC must be on the SAME Wi-Fi network.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Cloudinary configuration used for direct client uploads.
# If these are not set, the app will send images to the backend upload route instead.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ──────────────────────────────────────────────────────────────────
# Firebase Configuration
# Get these from: Firebase Console → Project Settings → General
# ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_CAT_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ──────────────────────────────────────────────────────────────────
# Google OAuth — Web Client ID
# Get this from: Firebase Console → Authentication → Sign-in Method
#   → Google → Web SDK configuration → Web client ID
# Or: Google Cloud Console → APIs & Services → Credentials
# ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
